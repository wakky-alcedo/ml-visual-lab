---
// モジュール本文ページ。modules コレクションから静的生成する。
import { getCollection, render } from "astro:content";
import ModuleLayout from "../../layouts/ModuleLayout.astro";

export async function getStaticPaths() {
  const modules = await getCollection("modules");
  // 番号順に並べて前後リンクを作る。
  const sorted = modules.sort((a, b) => a.data.number - b.data.number);
  return sorted.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: i > 0 ? sorted[i - 1] : undefined,
      next: i < sorted.length - 1 ? sorted[i + 1] : undefined,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);

const toNav = (e: typeof entry | undefined) =>
  e ? { slug: e.id, number: e.data.number, title: e.data.title } : undefined;
---

<ModuleLayout
  number={entry.data.number}
  title={entry.data.title}
  minutes={entry.data.minutes}
  description={entry.data.description}
  headings={headings}
  colab={entry.data.colab}
  prev={toNav(prev)}
  next={toNav(next)}
>
  <Content />
</ModuleLayout>
