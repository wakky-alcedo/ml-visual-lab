---
// 教養コラム用の囲み。就活教養・事例紹介などの本文脇の読み物に使う。
// 使い方: <Column title="生成AIまでの年表">…本文…</Column>
interface Props {
  /** コラムの見出し。 */
  title: string;
  /** 見出し脇の小さなラベル（既定「コラム」）。 */
  kicker?: string;
}

const { title, kicker = "コラム" } = Astro.props;
---

<aside class="column">
  <div class="column__kicker">{kicker}</div>
  <h4 class="column__title">{title}</h4>
  <div class="column__body">
    <slot />
  </div>
</aside>

<style>
  .column {
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-6) 0;
  }
  .column__kicker {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: 0.05em;
  }
  .column__title {
    margin: var(--space-1) 0 var(--space-3);
    font-size: var(--text-lg);
  }
  .column__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
