---
const W = 480, H = 220;
const padTop = 20, padRight = 20, padBottom = 40, padLeft = 50;
const plotW = W - padLeft - padRight;
const plotH = H - padTop - padBottom;
const xMin = -4, xMax = 4, yMin = 0, yMax = 4;

const toX = (x: number) => ((x - xMin) / (xMax - xMin)) * plotW + padLeft;
const toY = (y: number) => (1 - (y - yMin) / (yMax - yMin)) * plotH + padTop;

// ReLU: max(0, z)
const pts: string[] = [];
// flat part (negative side)
pts.push(`${toX(xMin).toFixed(2)},${toY(0).toFixed(2)}`);
pts.push(`${toX(0).toFixed(2)},${toY(0).toFixed(2)}`);
// linear part (positive side)
pts.push(`${toX(xMax).toFixed(2)},${toY(xMax).toFixed(2)}`);
const polyline = pts.join(" ");

const axisY = toY(0);
const axisX = padLeft;
const x0 = toX(0);

const xTicks = [-4, -2, 0, 2, 4].map((v) => ({ v, px: toX(v) }));
const yTicks = [0, 1, 2, 3, 4].map((v) => ({ v, py: toY(v) }));
---

<figure class="inline-chart">
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-label="ReLU関数のグラフ" role="img">
    <rect x="0" y="0" width={W} height={H} fill="#f6f7f9" rx="6" />

    {yTicks.map(({ py }) => (
      <line x1={axisX} y1={py} x2={axisX + plotW} y2={py} stroke="#d9dde2" stroke-width="1" />
    ))}

    {/* x=0 の折れ点を強調 */}
    <line x1={x0} y1={padTop} x2={x0} y2={axisY}
          stroke="#5b636d" stroke-width="1" stroke-dasharray="4,4" opacity="0.5" />

    {/* 軸 */}
    <line x1={axisX} y1={padTop} x2={axisX} y2={axisY + 2} stroke="#1b1f24" stroke-width="1.5" />
    <line x1={axisX} y1={axisY} x2={axisX + plotW} y2={axisY} stroke="#1b1f24" stroke-width="1.5" />

    {/* ReLU 曲線 */}
    <polyline points={polyline} fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />

    {/* 目盛りラベル */}
    {yTicks.map(({ v, py }) => (
      <text x={axisX - 8} y={py + 4} text-anchor="end" font-size="12" fill="#5b636d">{v}</text>
    ))}
    {xTicks.map(({ v, px }) => (
      <text x={px} y={axisY + 16} text-anchor="middle" font-size="12" fill="#5b636d">{v}</text>
    ))}

    {/* 軸ラベル */}
    <text x={axisX + plotW + 8} y={axisY + 4} font-size="13" fill="#1b1f24" font-style="italic">z</text>
    <text x={axisX - 4} y={padTop - 6} text-anchor="middle" font-size="12" fill="#1b1f24">ReLU(z)</text>

    {/* 折れ点アノテーション */}
    <circle cx={x0} cy={axisY} r="4" fill="#2563eb" />
    <text x={x0 + 8} y={axisY - 8} font-size="11" fill="#2563eb">折れ点 (0, 0)</text>

    {/* 傾き=1 の注釈 */}
    <text x={toX(2.5)} y={toY(2.5) - 10} font-size="11" fill="#2563eb">傾き = 1</text>

    {/* 傾き=0 の注釈 */}
    <text x={toX(-2)} y={axisY - 10} text-anchor="middle" font-size="11" fill="#5b636d">傾き = 0</text>
  </svg>
  <figcaption>図: ReLU(z) = max(0, z) ── z が負のとき出力は0（勾配も0）、z が正のとき出力はzそのまま（勾配は常に1）。シグモイドと違い、正の領域で傾きが消えない。</figcaption>
</figure>

<style>
  .inline-chart {
    margin: 1.25rem 0;
    text-align: center;
  }
  .inline-chart svg {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .inline-chart figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted, #5b636d);
  }
</style>
